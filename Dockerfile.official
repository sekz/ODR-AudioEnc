# StreamDAB ODR-AudioEnc Multi-Instance - Based on Official ODR Image
# Uses opendigitalradio/encoders as base with multi-instance wrapper

FROM opendigitalradio/encoders:latest

# Install additional dependencies for multi-instance management
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    curl \
    netcat-openbsd \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages for health endpoints
RUN pip3 install aiohttp

# Create streamdab user (matching our infrastructure)
RUN groupadd -r streamdab -g 999 && \
    useradd -r -g streamdab -u 999 streamdab || true

# Create required directories
RUN mkdir -p \
    /app/data \
    /app/logs \
    /var/log/odr \
    /tmp/fifo \
    && chown -R streamdab:streamdab /app /var/log/odr \
    && chmod 1777 /tmp/fifo

# Copy multi-instance entrypoint scripts
COPY entrypoint-multi.sh /app/
COPY entrypoint-multi-with-health.sh /app/
RUN chmod +x /app/entrypoint-multi*.sh && \
    chown streamdab:streamdab /app/entrypoint-multi*.sh

# Update binary paths in entrypoint to use /usr/bin/odr-audioenc
RUN sed -i 's|/app/src/odr-audioenc|/usr/bin/odr-audioenc|g' /app/entrypoint-multi-with-health.sh && \
    sed -i 's|/app/build/bin/odr-audioenc|/usr/bin/odr-audioenc|g' /app/entrypoint-multi-with-health.sh

WORKDIR /app

# Expose API ports for 3 instances (8100-8102 for dev)
EXPOSE 8100 8101 8102
# Expose TCP ports for audio input (8010-8012)
EXPOSE 8010 8011 8012

# Health check - verify at least one instance is running
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -f http://localhost:8100/health || curl -f http://localhost:8101/health || curl -f http://localhost:8102/health || exit 1

# Default environment variables
ENV INSTANCE_COUNT=3 \
    FIFO_BASE_PATH=/tmp/fifo \
    PORT_BASE=8010 \
    API_PORT_BASE=8100 \
    BITRATE=128 \
    CHANNELS=2 \
    SAMPLE_RATE=48000 \
    STREAMDAB_COMPONENT=audioenc-multi

USER streamdab

# Use multi-instance entrypoint with health endpoints
ENTRYPOINT ["/app/entrypoint-multi-with-health.sh"]
