# Dockerfile.mock - Mock AudioEnc for infrastructure testing
# Base: Official OpenDigitalRadio encoders image
# Mode: Mock (simulated behavior without real audio processing)

FROM opendigitalradio/encoders:latest

LABEL version="1.0.0-mock"
LABEL component="audio-encoder"
LABEL mode="mock"
LABEL description="Mock ODR-AudioEnc for StreamDAB multi-instance testing"

# Install Python and dependencies for health server
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    && pip3 install --no-cache-dir aiohttp==3.9.1 \
    && rm -rf /var/lib/apt/lists/*

# Create user and directories
RUN groupadd -g 999 streamdab && \
    useradd -r -u 999 -g streamdab streamdab && \
    mkdir -p /var/log/odr /tmp/fifo /app && \
    chown -R streamdab:streamdab /var/log/odr /tmp/fifo /app

# Copy mock binary (replaces real odr-audioenc)
COPY --chown=streamdab:streamdab mock-odr-audioenc.sh /usr/bin/odr-audioenc
COPY --chown=streamdab:streamdab entrypoint-multi-with-health.sh /app/
COPY --chown=streamdab:streamdab health_server.py /app/

# Make scripts executable
RUN chmod +x /usr/bin/odr-audioenc /app/*.sh /app/*.py

# Environment variables
ENV INSTANCE_COUNT=3 \
    API_PORT_BASE=8100 \
    PORT_BASE=8010 \
    LOG_LEVEL=info

# Expose ports
# Health/API: 8100-8105 (per PORT-ALLOCATION-PLAN.md)
# TCP Output: 8010-8012
EXPOSE 8100-8105 8010-8012

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8100/health').read()" || exit 1

USER streamdab
WORKDIR /app

ENTRYPOINT ["/app/entrypoint-multi-with-health.sh"]
